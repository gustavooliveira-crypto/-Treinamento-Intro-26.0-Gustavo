generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb+srv://gustavooliveira_db_user:6JcdghwDvRPGlEnx@cluster0.cshrnay.mongodb.net/lojinha?appName=Cluster0"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model Compra {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  precoTotal Float

  userId     String
  user       User      @relation(fields: [userId], references: [id])

  produtoIds String[]  @db.ObjectId
  produtos   Produto[] @relation(fields: [produtoIds], references: [id])
}

model Produto {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  descricao    String
  preco        Float

  categoriaIds String[]    @db.ObjectId
  categorias   Categoria[] @relation(fields: [categoriaIds], references: [id])

  compraIds    String[]    @db.ObjectId
  compras      Compra[]    @relation(fields: [compraIds], references: [id])
}

model Categoria {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  nome       String

  produtoIds String[]  @db.ObjectId
  produtos   Produto[] @relation(fields: [produtoIds], references: [id])
}

model User {
  // nao mexer entre aqui >
  id            String    @id @map("_id") // o id do user deve ser assim por causa do better auth
  name          String
  email         String    @unique
  emailVerified Boolean?
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  role          Role      @default(USER)
  // < e aqui

  compras       Compra[]

  @@map("user")
}

// evitar mexer daqui pra baixo
// nesses 3 modelos do better auth
model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}